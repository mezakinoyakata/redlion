<Window x:Class="EDCBViewer.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="設定" Height="600" Width="560"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#FF1E1E1E">
    <Window.Resources>
        <Style TargetType="Label">
            <Setter Property="Foreground" Value="#FF888888"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="0,4,0,2"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#FF2D2D2D"/>
            <Setter Property="Foreground" Value="#FFE0E0E0"/>
            <Setter Property="BorderBrush" Value="#FF555555"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#FF3C3C3C"/>
            <Setter Property="Foreground" Value="#FFE0E0E0"/>
            <Setter Property="BorderBrush" Value="#FF555555"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="Separator">
            <Setter Property="Background" Value="#FF444444"/>
            <Setter Property="Margin" Value="0,8,0,4"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#FFE0E0E0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,6,0,0"/>
        </Style>
    </Window.Resources>

    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="キャンセル" Width="90" Margin="0,0,8,0" Click="Cancel_Click"/>
            <Button Content="保存" Width="90" Click="Save_Click"
                    Background="#FF0078D4" BorderBrush="#FF0078D4"/>
        </StackPanel>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 表示件数 -->
            <Label Grid.Row="0" Content="1ページの表示件数"/>
            <TextBox x:Name="MaxRecItemsBox" Grid.Row="1"/>

            <Separator Grid.Row="2"/>

            <!-- MPC-BE -->
            <Label Grid.Row="3" Content="MPC-BE の実行ファイルパス"/>
            <DockPanel Grid.Row="4">
                <Button DockPanel.Dock="Right" Content="参照..." Width="60"
                        Margin="6,0,0,0" Click="Browse_Click"/>
                <TextBox x:Name="PlayerPathBox"/>
            </DockPanel>

            <Separator Grid.Row="5"/>

            <!-- 起点フォルダ（複数） -->
            <Label Grid.Row="6" Content="起点フォルダ（複数指定可）"/>
            <DockPanel Grid.Row="7" Height="120">
                <StackPanel DockPanel.Dock="Right" Width="70" Margin="6,0,0,0">
                    <Button Content="追加..." Margin="0,0,0,4" Click="AddFolder_Click"/>
                    <Button Content="削除" Click="RemoveFolder_Click"/>
                </StackPanel>
                <ListBox x:Name="FolderListBox"
                         Background="#FF2D2D2D" Foreground="#FFE0E0E0"
                         BorderBrush="#FF555555" FontFamily="Consolas" FontSize="12"/>
            </DockPanel>

            <Separator Grid.Row="8"/>

            <!-- PostgreSQL(Supabase) 接続文字列 -->
            <Label Grid.Row="9" Content="DB 接続文字列　例: Host=5950X;Port=5432;Database=postgres;Username=postgres.xxx;Password=xxx"/>
            <TextBox x:Name="DbConnectionStringBox" Grid.Row="10"
                     FontFamily="Consolas" FontSize="12"/>

            <Separator Grid.Row="11"/>

            <!-- EPG データフォルダ -->
            <Label Grid.Row="12" Content="EPG データフォルダ（*_epg.dat の場所。空なら取り込まない）"/>
            <DockPanel Grid.Row="13">
                <Button DockPanel.Dock="Right" Content="参照..." Width="60"
                        Margin="6,0,0,0" Click="BrowseEpgFolder_Click"/>
                <TextBox x:Name="EpgDataFolderBox" FontFamily="Consolas" FontSize="12"/>
            </DockPanel>
            <Label Grid.Row="14" Content="起動時と「更新」時に、このフォルダを読んで EPG を DB に取り込みます"/>
        </Grid>
    </DockPanel>
</Window>
