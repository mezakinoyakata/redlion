<Window x:Class="EDCBViewer.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="設定" Height="370" Width="560"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#FF1E1E1E">
    <Window.Resources>
        <Style TargetType="Label">
            <Setter Property="Foreground" Value="#FF888888"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="0,4,0,2"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#FF2D2D2D"/>
            <Setter Property="Foreground" Value="#FFE0E0E0"/>
            <Setter Property="BorderBrush" Value="#FF555555"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#FF3C3C3C"/>
            <Setter Property="Foreground" Value="#FFE0E0E0"/>
            <Setter Property="BorderBrush" Value="#FF555555"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="Separator">
            <Setter Property="Background" Value="#FF444444"/>
            <Setter Property="Margin" Value="0,8,0,4"/>
        </Style>
    </Window.Resources>

    <DockPanel Margin="16">
        <!-- ボタン行 -->
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="キャンセル" Width="90" Margin="0,0,8,0" Click="Cancel_Click"/>
            <Button Content="保存" Width="90" Click="Save_Click"
                    Background="#FF0078D4" BorderBrush="#FF0078D4"/>
        </StackPanel>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- EMWUI URL -->
            <Label Grid.Row="0" Content="EMWUI URL　例: http://5600x:5510"
                   Foreground="#FF6BC5FF"/>
            <TextBox x:Name="EmwuiUrlBox" Grid.Row="1"/>

            <!-- 取得件数 -->
            <Label Grid.Row="2" Content="録画済み取得件数（新しい順に N 件）"/>
            <TextBox x:Name="MaxRecItemsBox" Grid.Row="3"/>

            <Separator Grid.Row="4"/>

            <!-- 録画フォルダ（追っかけ再生用） -->
            <Label Grid.Row="5" Content="録画フォルダのパス（追っかけ再生用）　例: \\5600x\d\PT2"/>
            <TextBox x:Name="RecFolderBox" Grid.Row="6"/>

            <!-- MPC-BE -->
            <Label Grid.Row="7" Content="MPC-BE の実行ファイルパス"/>
            <DockPanel Grid.Row="8">
                <Button DockPanel.Dock="Right" Content="参照..." Width="60"
                        Margin="6,0,0,0" Click="Browse_Click"/>
                <TextBox x:Name="PlayerPathBox"/>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
