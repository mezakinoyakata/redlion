<Window x:Class="EDCBViewer.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="設定" Height="360" Width="560"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#FF1E1E1E">
    <Window.Resources>
        <Style TargetType="Label">
            <Setter Property="Foreground" Value="#FF888888"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="0,4,0,2"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#FF2D2D2D"/>
            <Setter Property="Foreground" Value="#FFE0E0E0"/>
            <Setter Property="BorderBrush" Value="#FF555555"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#FF3C3C3C"/>
            <Setter Property="Foreground" Value="#FFE0E0E0"/>
            <Setter Property="BorderBrush" Value="#FF555555"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <DockPanel Margin="16">
        <!-- ボタン行 -->
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="キャンセル" Width="90" Margin="0,0,8,0" Click="Cancel_Click"/>
            <Button Content="保存" Width="90" Click="Save_Click"
                    Background="#FF0078D4" BorderBrush="#FF0078D4"/>
        </StackPanel>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Label Grid.Row="0" Content="RecInfo.txt のパス"/>
            <TextBox x:Name="RecInfoPathBox" Grid.Row="1"/>

            <Label Grid.Row="2" Content="Reserve.txt のパス"/>
            <TextBox x:Name="ReservePathBox" Grid.Row="3"/>

            <Label Grid.Row="4" Content="録画フォルダのパス"/>
            <TextBox x:Name="RecFolderBox" Grid.Row="5"/>

            <Label Grid.Row="6" Content="MPC-BE の実行ファイルパス"/>
            <DockPanel Grid.Row="7">
                <Button DockPanel.Dock="Right" Content="参照..." Width="60"
                        Margin="6,0,0,0" Click="Browse_Click"/>
                <TextBox x:Name="PlayerPathBox"/>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
