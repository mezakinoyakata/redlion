<Window x:Class="EDCBViewer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EDCB Viewer" Height="700" Width="1100" MinHeight="500" MinWidth="800"
        Background="#FF1E1E1E"
        PreviewKeyDown="Window_PreviewKeyDown"
        KeyDown="Window_KeyDown"
        Closing="Window_Closing">
    <Window.Resources>
        <Style TargetType="ListView">
            <Setter Property="Background" Value="#FF2D2D2D"/>
            <Setter Property="Foreground" Value="#FFE0E0E0"/>
            <Setter Property="BorderBrush" Value="#FF444444"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style TargetType="GridViewColumnHeader">
            <Setter Property="Background" Value="#FF3C3C3C"/>
            <Setter Property="Foreground" Value="#FFE0E0E0"/>
            <Setter Property="BorderBrush" Value="#FF555555"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="ListViewItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#FF0078D4"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FF3A3A3A"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="TabControl">
            <Setter Property="Background" Value="#FF1E1E1E"/>
            <Setter Property="BorderBrush" Value="#FF444444"/>
        </Style>
        <!-- TabItemはデフォルトTemplateがBrushを上書きするためControlTemplateを差し替える -->
        <Style TargetType="TabItem">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder"
                                Background="#FF2D2D2D"
                                BorderBrush="#FF444444" BorderThickness="1,1,1,0"
                                Padding="14,6" Margin="0,0,2,0">
                            <ContentPresenter x:Name="TabLabel"
                                              ContentSource="Header"
                                              TextBlock.Foreground="#FFB0B0B0"
                                              TextBlock.FontSize="13"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#FF1E1E1E"/>
                                <Setter TargetName="TabBorder" Property="BorderThickness" Value="1,1,1,0"/>
                                <Setter TargetName="TabLabel" Property="TextBlock.Foreground" Value="White"/>
                                <Setter TargetName="TabLabel" Property="TextBlock.FontWeight" Value="SemiBold"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#FF3A3A3A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TextBlock" x:Key="InfoLabel">
            <Setter Property="Foreground" Value="#FF888888"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,6,0,2"/>
        </Style>
        <Style TargetType="TextBlock" x:Key="InfoValue">
            <Setter Property="Foreground" Value="#FFE0E0E0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#FF3C3C3C"/>
            <Setter Property="Foreground" Value="#FFE0E0E0"/>
            <Setter Property="BorderBrush" Value="#FF555555"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FF4A4A4A"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <!-- 右ペイン値テキスト（選択可能・読み取り専用）-->
        <Style x:Key="SelectableValue" TargetType="TextBox">
            <Setter Property="IsReadOnly"       Value="True"/>
            <Setter Property="Background"       Value="Transparent"/>
            <Setter Property="BorderThickness"  Value="0"/>
            <Setter Property="Foreground"       Value="#FFE0E0E0"/>
            <Setter Property="FontSize"         Value="13"/>
            <Setter Property="TextWrapping"     Value="Wrap"/>
            <Setter Property="Padding"          Value="0"/>
            <Setter Property="Margin"           Value="0"/>
            <Setter Property="SelectionBrush"   Value="#FF0078D4"/>
            <Setter Property="CaretBrush"       Value="Transparent"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Cursor"           Value="IBeam"/>
            <!-- chrome を完全除去して TextBlock と同じ見た目にする -->
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                                      HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollBarVisibility="Hidden"
                                      Padding="0" Margin="0"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 検索ボックス用スタイル -->
        <Style x:Key="SearchBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#FFE0E0E0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CaretBrush" Value="#FFE0E0E0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="SelectionBrush" Value="#FF0078D4"/>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- メニューバー -->
        <Menu DockPanel.Dock="Top" Background="#FF2D2D2D" Foreground="#FFE0E0E0">
            <MenuItem Header="設定" Foreground="#FFE0E0E0">
                <MenuItem Header="パス設定..." Click="Settings_Click" Foreground="#FF1E1E1E"/>
            </MenuItem>
            <MenuItem x:Name="RefreshMenuItem" Header="更新 (F5)" Click="Refresh_Click" Foreground="#FFE0E0E0"/>
        </Menu>

        <!-- ステータスバー -->
        <StatusBar DockPanel.Dock="Bottom" Background="#FF2D2D2D">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Foreground="#FF888888" FontSize="11"
                           Text=""/>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock x:Name="LastUpdateText" Foreground="#FF666666" FontSize="11"/>
            </StatusBarItem>
        </StatusBar>

        <!-- メインコンテンツ -->
        <TabControl x:Name="MainTab" SelectionChanged="MainTab_SelectionChanged">

            <!-- 録画済みタブ -->
            <TabItem Header="録画済み">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" MinWidth="400"/>
                        <ColumnDefinition Width="5"/>
                        <ColumnDefinition Width="1*" MinWidth="250"/>
                    </Grid.ColumnDefinitions>

                    <!-- 録画一覧 (検索バー + リスト) -->
                    <Grid Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- 検索バー -->
                        <Border Grid.Row="0" Background="#FF252525"
                                BorderBrush="#FF444444" BorderThickness="0,0,0,1"
                                Padding="8,5">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Left"
                                           Text="検索:" Foreground="#FF888888"
                                           FontSize="12" VerticalAlignment="Center"
                                           Margin="0,0,6,0"/>
                                <Button DockPanel.Dock="Right" Content="検索"
                                        Width="52" Padding="4,2" Margin="6,0,0,0"
                                        Click="RecSearch_Click"/>
                                <CheckBox x:Name="FullTextCheck"
                                          DockPanel.Dock="Right"
                                          Content="番組情報も" Foreground="#FF888888"
                                          FontSize="11" VerticalAlignment="Center"
                                          Margin="8,0,0,0"
                                          IsChecked="True"
                                          Checked="FullTextCheck_Changed"
                                          Unchecked="FullTextCheck_Changed"/>
                                <CheckBox x:Name="RegexCheck"
                                          DockPanel.Dock="Right"
                                          Content="正規表現" Foreground="#FF888888"
                                          FontSize="11" VerticalAlignment="Center"
                                          Margin="8,0,0,0"
                                          Checked="RegexCheck_Changed"
                                          Unchecked="RegexCheck_Changed"/>
                                <TextBox x:Name="RecSearchBox"
                                         Style="{StaticResource SearchBoxStyle}"
                                         TextChanged="RecSearchBox_TextChanged"
                                         KeyDown="RecSearchBox_KeyDown"/>
                            </DockPanel>
                        </Border>

                        <!-- ページナビゲーション -->
                        <Border Grid.Row="1" Background="#FF222222"
                                BorderBrush="#FF444444" BorderThickness="0,0,0,1"
                                Padding="4,3">
                            <DockPanel>
                                <Button x:Name="FirstPageButton" DockPanel.Dock="Left"
                                        Content="⏮" Width="32" Padding="4,2"
                                        Click="FirstPage_Click" IsEnabled="False"
                                        Margin="0,0,2,0"/>
                                <Button x:Name="PrevPageButton" DockPanel.Dock="Left"
                                        Content="◀ 前" Width="52" Padding="4,2"
                                        Click="PrevPage_Click" IsEnabled="False"/>
                                <Button x:Name="LastPageButton" DockPanel.Dock="Right"
                                        Content="⏭" Width="32" Padding="4,2"
                                        Click="LastPage_Click" IsEnabled="False"
                                        Margin="2,0,0,0"/>
                                <Button x:Name="NextPageButton" DockPanel.Dock="Right"
                                        Content="次 ▶" Width="52" Padding="4,2"
                                        Click="NextPage_Click" IsEnabled="False"/>
                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center">
                                    <TextBlock x:Name="PageLabel"
                                               Foreground="#FFB0B0B0" FontSize="12"/>
                                    <TextBlock x:Name="RecCountText"
                                               Foreground="#FF888888" FontSize="12"
                                               Margin="16,0,0,0"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <!-- 録画リスト -->
                        <ListView x:Name="RecInfoList" Grid.Row="2"
                                  SelectionChanged="RecInfoList_SelectionChanged"
                                  MouseDoubleClick="RecInfoList_DoubleClick"
                                  GridViewColumnHeader.Click="RecInfoList_ColumnHeaderClick">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="タイトル" Width="300"
                                        DisplayMemberBinding="{Binding Title}"/>
                                    <GridViewColumn Header="放送局" Width="100"
                                        DisplayMemberBinding="{Binding ServiceName}"/>
                                    <GridViewColumn Header="開始日時" Width="130">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding StartTime, StringFormat='yyyy/MM/dd HH:mm'}"
                                                           Foreground="#FFE0E0E0"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="時間" Width="60"
                                        DisplayMemberBinding="{Binding DurationText}"/>
                                    <GridViewColumn Header="状態" Width="70">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding RecStatusText}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="#FFE0E0E0"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasDrops}" Value="True">
                                                                    <Setter Property="Foreground" Value="#FFFF6B6B"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </Grid>

                    <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch"
                                  Background="#FF444444"/>

                    <!-- 番組情報パネル -->
                    <ScrollViewer Grid.Column="2" Background="#FF252525"
                                  VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="RecInfoPanel" Margin="12">

                            <TextBox x:Name="RecTitle" Style="{StaticResource SelectableValue}"
                                     Foreground="White" FontSize="15" FontWeight="SemiBold"
                                     Margin="0,0,0,8"/>

                            <TextBlock Style="{StaticResource InfoLabel}" Text="放送局"/>
                            <TextBox x:Name="RecService" Style="{StaticResource SelectableValue}"/>

                            <TextBlock Style="{StaticResource InfoLabel}" Text="放送日時"/>
                            <TextBox x:Name="RecDateTime" Style="{StaticResource SelectableValue}"/>

                            <TextBlock Style="{StaticResource InfoLabel}" Text="録画ファイル"/>
                            <TextBox x:Name="RecFilePath" Style="{StaticResource SelectableValue}"
                                     FontSize="11" Foreground="#FFB0B0B0"/>

                            <TextBlock Style="{StaticResource InfoLabel}" Text="ドロップ / スクランブル"/>
                            <TextBox x:Name="RecDrops" Style="{StaticResource SelectableValue}"/>

                            <TextBlock x:Name="RecProgramInfoLabel"
                                       Style="{StaticResource InfoLabel}" Text="番組情報"
                                       Visibility="Collapsed"/>
                            <TextBox x:Name="RecProgramInfo" Style="{StaticResource SelectableValue}"
                                     FontSize="12" Visibility="Collapsed"/>

                            <Button x:Name="PlayButton" Content="MPC-BE で再生"
                                    Margin="0,16,0,0" HorizontalAlignment="Left"
                                    Click="PlayButton_Click" Visibility="Collapsed"/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- 予約タブ -->
            <TabItem Header="予約録画">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" MinWidth="400"/>
                        <ColumnDefinition Width="5"/>
                        <ColumnDefinition Width="1*" MinWidth="250"/>
                    </Grid.ColumnDefinitions>

                    <!-- 予約一覧 (検索バー + リスト) -->
                    <Grid Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- 検索バー -->
                        <Border Grid.Row="0" Background="#FF252525"
                                BorderBrush="#FF444444" BorderThickness="0,0,0,1"
                                Padding="8,5">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Left"
                                           Text="絞込:" Foreground="#FF888888"
                                           FontSize="12" VerticalAlignment="Center"
                                           Margin="0,0,6,0"/>
                                <TextBox x:Name="ResSearchBox"
                                         Style="{StaticResource SearchBoxStyle}"
                                         TextChanged="ResSearchBox_TextChanged"/>
                            </DockPanel>
                        </Border>

                        <!-- 予約リスト -->
                        <ListView x:Name="ReserveList" Grid.Row="1"
                                  SelectionChanged="ReserveList_SelectionChanged"
                                  MouseDoubleClick="ReserveList_DoubleClick"
                                  GridViewColumnHeader.Click="ReserveList_ColumnHeaderClick">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="タイトル" Width="300"
                                        DisplayMemberBinding="{Binding Title}"/>
                                    <GridViewColumn Header="放送局" Width="100"
                                        DisplayMemberBinding="{Binding StationName}"/>
                                    <GridViewColumn Header="開始日時" Width="130">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding StartTime, StringFormat='yyyy/MM/dd HH:mm'}"
                                                           Foreground="#FFE0E0E0"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="時間" Width="60"
                                        DisplayMemberBinding="{Binding DurationText}"/>
                                    <GridViewColumn Header="状態" Width="80">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding StatusText}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="#FFE0E0E0"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsRecording}" Value="True">
                                                                    <Setter Property="Foreground" Value="#FF6BFF6B"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </Grid>

                    <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch"
                                  Background="#FF444444"/>

                    <!-- 予約詳細パネル -->
                    <ScrollViewer Grid.Column="2" Background="#FF252525"
                                  VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="ReservePanel" Margin="12">

                            <TextBox x:Name="ResTitle" Style="{StaticResource SelectableValue}"
                                     Foreground="White" FontSize="15" FontWeight="SemiBold"
                                     Margin="0,0,0,8"/>

                            <TextBlock Style="{StaticResource InfoLabel}" Text="放送局"/>
                            <TextBox x:Name="ResStation" Style="{StaticResource SelectableValue}"/>

                            <TextBlock Style="{StaticResource InfoLabel}" Text="放送日時"/>
                            <TextBox x:Name="ResDateTime" Style="{StaticResource SelectableValue}"/>

                            <TextBlock Style="{StaticResource InfoLabel}" Text="状態"/>
                            <TextBox x:Name="ResStatus" Style="{StaticResource SelectableValue}"/>

                            <TextBlock Style="{StaticResource InfoLabel}" Text="コメント"/>
                            <TextBox x:Name="ResComment" Style="{StaticResource SelectableValue}"
                                     FontSize="12"/>

                            <TextBlock x:Name="ResProgramInfoLabel"
                                       Style="{StaticResource InfoLabel}" Text="番組情報"/>
                            <TextBox x:Name="ResProgramInfo" Style="{StaticResource SelectableValue}"
                                     FontSize="12" TextWrapping="Wrap"/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>

        </TabControl>
    </DockPanel>
</Window>
