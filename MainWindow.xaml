<Window x:Class="EDCBViewer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EDCB Viewer" Height="700" Width="1100" MinHeight="500" MinWidth="800"
        Background="#FF1E1E1E"
        PreviewKeyDown="Window_PreviewKeyDown"
        PreviewTextInput="Window_PreviewTextInput"
        KeyDown="Window_KeyDown"
        Closing="Window_Closing">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <Style TargetType="ListView">
            <Setter Property="Background" Value="#FF2D2D2D"/>
            <Setter Property="Foreground" Value="#FFE0E0E0"/>
            <Setter Property="BorderBrush" Value="#FF444444"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style TargetType="GridViewColumnHeader">
            <Setter Property="Background" Value="#FF3C3C3C"/>
            <Setter Property="Foreground" Value="#FFE0E0E0"/>
            <Setter Property="BorderBrush" Value="#FF555555"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="ListViewItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#FF0078D4"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FF3A3A3A"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="TextBlock" x:Key="InfoLabel">
            <Setter Property="Foreground" Value="#FF888888"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,6,0,2"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#FF3C3C3C"/>
            <Setter Property="Foreground" Value="#FFE0E0E0"/>
            <Setter Property="BorderBrush" Value="#FF555555"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FF4A4A4A"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SelectableValue" TargetType="TextBox">
            <Setter Property="IsReadOnly"       Value="True"/>
            <Setter Property="Background"       Value="Transparent"/>
            <Setter Property="BorderThickness"  Value="0"/>
            <Setter Property="Foreground"       Value="#FFE0E0E0"/>
            <Setter Property="FontSize"         Value="13"/>
            <Setter Property="TextWrapping"     Value="Wrap"/>
            <Setter Property="Padding"          Value="0"/>
            <Setter Property="Margin"           Value="0"/>
            <Setter Property="SelectionBrush"   Value="#FF0078D4"/>
            <Setter Property="CaretBrush"       Value="Transparent"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Cursor"           Value="IBeam"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                                      HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollBarVisibility="Hidden"
                                      Padding="0" Margin="0"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SearchBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#FFE0E0E0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CaretBrush" Value="#FFE0E0E0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="SelectionBrush" Value="#FF0078D4"/>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- メニューバー -->
        <Menu DockPanel.Dock="Top" Background="#FF2D2D2D" Foreground="#FFE0E0E0">
            <MenuItem Header="設定" Foreground="#FFE0E0E0">
                <MenuItem Header="パス設定..." Click="Settings_Click" Foreground="#FF1E1E1E"/>
            </MenuItem>
            <MenuItem x:Name="RefreshMenuItem" Header="更新 (F5)" Click="Refresh_Click" Foreground="#FFE0E0E0"/>
            <MenuItem Header="番組表" Click="EpgGuide_Click" Foreground="#FFE0E0E0"/>
        </Menu>

        <!-- ステータスバー -->
        <StatusBar DockPanel.Dock="Bottom" Background="#FF2D2D2D">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Foreground="#FF888888" FontSize="11" Text=""/>
            </StatusBarItem>
        </StatusBar>

        <!-- メインコンテンツ（ディレクトリ） -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" MinWidth="400"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="1*" MinWidth="250"/>
            </Grid.ColumnDefinitions>

            <!-- ファイル一覧 (パスバー + 検索バー + ページング + リスト) -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- アドレスバー -->
                <Border x:Name="DirAddressBar" Grid.Row="0" Background="#FF1A1A1A"
                        BorderBrush="#FF444444" BorderThickness="0,0,0,1"
                        Padding="6,4">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="…"
                                Width="32" Padding="4,2" Margin="4,0,0,0"
                                Click="DirBrowse_Click" ToolTip="フォルダを選択"/>
                        <TextBox x:Name="DirPathBox"
                                 Background="Transparent" Foreground="#FFE0E0E0"
                                 BorderThickness="1" BorderBrush="#FF555555"
                                 CaretBrush="#FFE0E0E0" SelectionBrush="#FF0078D4"
                                 FontSize="12" Padding="4,2"
                                 VerticalAlignment="Center"
                                 KeyDown="DirPathBox_KeyDown"/>
                    </DockPanel>
                </Border>

                <!-- 検索バー -->
                <Border Grid.Row="1" Background="#FF252525"
                        BorderBrush="#FF444444" BorderThickness="0,0,0,1"
                        Padding="8,5">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Left"
                                   Text="絞込:" Foreground="#FF888888"
                                   FontSize="12" VerticalAlignment="Center"
                                   Margin="0,0,6,0"/>
                        <CheckBox x:Name="FastestOnlyCheck" DockPanel.Dock="Right"
                                  Content="最速のみ" Foreground="#FFE0E0E0"
                                  FontSize="12" VerticalAlignment="Center"
                                  Margin="8,0,0,0"
                                  Checked="FastestOnly_Changed" Unchecked="FastestOnly_Changed"/>
                        <TextBox x:Name="DirSearchBox"
                                 Style="{StaticResource SearchBoxStyle}"
                                 TextChanged="DirSearchBox_TextChanged"
                                 KeyDown="DirSearchBox_KeyDown"/>
                    </DockPanel>
                </Border>

                <!-- ページナビゲーション -->
                <Border Grid.Row="2" Background="#FF222222"
                        BorderBrush="#FF444444" BorderThickness="0,0,0,1"
                        Padding="4,3">
                    <DockPanel>
                        <Button x:Name="DirFirstPageButton" DockPanel.Dock="Left"
                                Content="⏮" Width="32" Padding="4,2"
                                Click="DirFirstPage_Click" IsEnabled="False"
                                Margin="0,0,2,0"/>
                        <Button x:Name="DirPrevPageButton" DockPanel.Dock="Left"
                                Content="◀ 前" Width="52" Padding="4,2"
                                Click="DirPrevPage_Click" IsEnabled="False"/>
                        <Button x:Name="DirLastPageButton" DockPanel.Dock="Right"
                                Content="⏭" Width="32" Padding="4,2"
                                Click="DirLastPage_Click" IsEnabled="False"
                                Margin="2,0,0,0"/>
                        <Button x:Name="DirNextPageButton" DockPanel.Dock="Right"
                                Content="次 ▶" Width="52" Padding="4,2"
                                Click="DirNextPage_Click" IsEnabled="False"/>
                        <Button DockPanel.Dock="Right" Content="更新"
                                Width="52" Padding="4,2" Margin="2,0,4,0"
                                Click="DirRefresh_Click"/>
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                            <TextBlock x:Name="DirPageLabel"
                                       Foreground="#FFB0B0B0" FontSize="12"/>
                            <TextBlock x:Name="DirCountText"
                                       Foreground="#FF888888" FontSize="12"
                                       Margin="16,0,0,0"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- ファイルリスト -->
                <ListView x:Name="DirList" Grid.Row="3"
                          SelectionChanged="DirList_SelectionChanged"
                          MouseDoubleClick="DirList_DoubleClick"
                          GridViewColumnHeader.Click="DirList_ColumnHeaderClick"
                          SizeChanged="DirList_SizeChanged">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="ファイル名" Width="400">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <!-- 最速放送はしょぼいカレンダー風に左端へ赤アクセントバー -->
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="5"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Rectangle Width="3" Fill="#FFE04848"
                                                       HorizontalAlignment="Left"
                                                       Visibility="{Binding IsFastest, Converter={StaticResource BoolToVis}}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding DisplayName}"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </Grid>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="放送局" Width="90"
                                DisplayMemberBinding="{Binding ParsedStation}"/>
                            <GridViewColumn Header="放送日時" Width="130">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding ParsedStartTimeText}"
                                                   Foreground="#FFE0E0E0"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="最速" Width="48">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding FastestText}"
                                                   Foreground="#FFE04848"
                                                   HorizontalAlignment="Center"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>
            </Grid>

            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch"
                          Background="#FF444444"/>

            <!-- 番組情報パネル -->
            <ScrollViewer Grid.Column="2" Background="#FF252525"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="DirInfoPanel" Margin="12">

                    <TextBox x:Name="DirTitle" Style="{StaticResource SelectableValue}"
                             Foreground="White" FontSize="15" FontWeight="SemiBold"
                             Margin="0,0,0,8"/>

                    <TextBlock Style="{StaticResource InfoLabel}" Text="放送局"/>
                    <TextBox x:Name="DirService" Style="{StaticResource SelectableValue}"/>

                    <TextBlock Style="{StaticResource InfoLabel}" Text="放送日時"/>
                    <TextBox x:Name="DirDateTime" Style="{StaticResource SelectableValue}"/>

                    <TextBlock Style="{StaticResource InfoLabel}" Text="ファイルパス"/>
                    <TextBox x:Name="DirFilePath" Style="{StaticResource SelectableValue}"
                             FontSize="11" Foreground="#FFB0B0B0"/>

                    <TextBlock Style="{StaticResource InfoLabel}" Text="ドロップ / スクランブル"/>
                    <TextBox x:Name="DirDrops" Style="{StaticResource SelectableValue}"/>

                    <TextBlock x:Name="DirProgramInfoLabel"
                               Style="{StaticResource InfoLabel}" Text="番組情報"
                               Visibility="Collapsed"/>
                    <TextBox x:Name="DirProgramInfo" Style="{StaticResource SelectableValue}"
                             FontSize="12" Visibility="Collapsed"/>

                    <Button x:Name="DirPlayButton" Content="MPC-BE で再生"
                            Margin="0,16,0,0" HorizontalAlignment="Left"
                            Click="DirPlayButton_Click" Visibility="Collapsed"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</Window>
